# --------- Firebase (client-safe; OK to expose to browser) ---------
# These are OPTIONAL — the app ships with a working fallback config baked
# into src/lib/firebase/client.ts. Override here only if you want to point
# the app at a DIFFERENT Firebase project (staging vs production, etc).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --------- Gemini (SERVER-ONLY — never expose) ---------
# REQUIRED for /dashboard/generate to work.
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --------- Stripe (SERVER + publishable) ---------
# Optional. Without these, /dashboard/billing renders but checkout returns 500.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe price IDs (create products in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# --------- App ---------
NEXT_PUBLIC_APP_URL=http://localhost:3000
